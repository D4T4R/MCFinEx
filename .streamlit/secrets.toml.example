# Copy to secrets.toml locally, or paste into Streamlit Cloud's Secrets box.
# secrets.toml itself is gitignored: it holds a live database credential.
MCFINEX_PG = "postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Addresses allowed to run the actions that fetch data and write to the
# database. Everything else on the site stays readable without signing in.
#
# An empty or absent list denies everyone, which is why it is not commented out
# below as a hint -- a missing line here should cost you a button, never open one.
MCFINEX_OPERATORS = ["you@example.com"]

# Native Streamlit OIDC. Without this whole section nobody can sign in, so the
# site is read-only for everybody including you -- which is a safe state, not a
# broken one.
#
# redirect_uri must match what the provider is configured with, exactly, and must
# end in /oauth2callback. Locally that is the dev server's own address.
# cookie_secret signs the session cookie: any long random string, and changing it
# signs everyone out.
[auth]
redirect_uri = "https://<your-app>.streamlit.app/oauth2callback"
cookie_secret = "<64+ random characters>"

# Google is the least work: console.cloud.google.com -> APIs & Services ->
# Credentials -> OAuth client ID -> Web application, with the redirect_uri above
# listed under "Authorised redirect URIs". Any OIDC provider works the same way;
# swap server_metadata_url for theirs.
[auth.google]
client_id = "<client-id>.apps.googleusercontent.com"
client_secret = "<client-secret>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
